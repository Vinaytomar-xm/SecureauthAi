# ── MongoDB ─────────────────────────────────────────────────────
# Use MongoDB Atlas for production (free tier works fine)
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://greehubUser:s3B489iqa8G0gFun@greenhub.fc7fjds.mongodb.net/?appName=greenhub

# ── Server ────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# CRITICAL: set this to your exact Vercel URL — NO trailing slash
FRONTEND_URL=https://secureauth-frontend-xi.vercel.app

# ── JWT ───────────────────────────────────────────────────────────
# CRITICAL: use a long random string — NOT a short number like 130507
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=130507
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=130507
JWT_REFRESH_EXPIRE=30d

# ── Email ─────────────────────────────────────────────────────────
# Gmail: use an App Password (not your real password)
# Create at: myaccount.google.com → Security → App Passwords
EMAIL_SERVICE=gmail
EMAIL_USER=tomarvinaysingh70@gmail.com
EMAIL_PASSWORD=pqdxqvxwhrkryahc
EMAIL_FROM="SecureAuth <tomarvinaysingh70@gmail.com>"

# ── Security ──────────────────────────────────────────────────────
OTP_EXPIRE=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=15

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Admin ─────────────────────────────────────────────────────────
# CRITICAL: use a strong password in production
ADMIN_EMAIL=admin@secureauth.com
ADMIN_PASSWORD=2949
