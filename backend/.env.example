# ── MongoDB ─────────────────────────────────────────────────────
# Use MongoDB Atlas for production (free tier works fine)
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://youruser:yourpassword@cluster.mongodb.net/secureauth

# ── Server ────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# CRITICAL: set this to your exact Vercel URL — NO trailing slash
FRONTEND_URL=https://secureauth-frontend-xi.vercel.app

# ── JWT ───────────────────────────────────────────────────────────
# CRITICAL: use a long random string — NOT a short number like 130507
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_64_char_hex_string
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRE=30d

# ── Email ─────────────────────────────────────────────────────────
# Gmail: use an App Password (not your real password)
# Create at: myaccount.google.com → Security → App Passwords
EMAIL_SERVICE=gmail
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=your_16_char_app_password
EMAIL_FROM="SecureAuth <your@gmail.com>"

# ── Security ──────────────────────────────────────────────────────
OTP_EXPIRE=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=15

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Admin ─────────────────────────────────────────────────────────
# CRITICAL: use a strong password in production
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=use_a_strong_password_not_4_digits
