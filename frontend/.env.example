# ── LOCAL development ─────────────────────────────────────────────────────────
# The Vite proxy handles /api calls locally, so VITE_API_URL is optional locally.
# VITE_API_URL=http://localhost:5000/api

# ── PRODUCTION (Vercel) ───────────────────────────────────────────────────────
# Set this in Vercel Dashboard → your project → Settings → Environment Variables
# Then redeploy — env vars need a fresh build.
VITE_API_URL=https://secureauth-backend-85f6.onrender.com/api
